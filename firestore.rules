rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // SECURITY HELPER FUNCTIONS
    // ─────────────────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // Role-based authorization via secure Firebase custom claims (NO email hardcoding)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (request.auth.token.role != null && request.auth.token.role == 'admin')
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 1. WALLET BALANCE & AFFILIATE METRICS: affiliate_stats
    // ─────────────────────────────────────────────────────────────────────────
    // Read: Authenticated user can read ONLY their own stats. Admins can read all.
    // Supports owner-scoped collection queries: where('userId', '==', auth.uid)
    // Write: COMPLETELY DENIED for clients. Updates must occur via trusted server.
    match /affiliate_stats/{refCode} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 2. WITHDRAWAL REQUESTS: withdrawal_requests
    // ─────────────────────────────────────────────────────────────────────────
    // Read: Authenticated user can read ONLY their own withdrawals. Admin can read all.
    // Supports owner-scoped collection queries: where('userId', '==', auth.uid)
    // Write: COMPLETELY DENIED for clients. Managed strictly via server endpoint.
    match /withdrawal_requests/{reqId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 3. REFERRAL COMMISSION IDEMPOTENCY: processed_referral_payments
    // ─────────────────────────────────────────────────────────────────────────
    // Server-only deduplication store. Client read/write completely blocked.
    match /processed_referral_payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 4. COURSE ENROLLMENTS: course_enrollments
    // ─────────────────────────────────────────────────────────────────────────
    // Read: Authenticated user can read ONLY their own verified course entitlements.
    // Supports owner-scoped collection queries: where('userId', '==', auth.uid)
    // Write: COMPLETELY DENIED for clients. Granted strictly via server webhook.
    match /course_enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 5. REGISTERED USERS & PROFILES: registered_users
    // ─────────────────────────────────────────────────────────────────────────
    // Strict Document Ownership Model:
    // - Document ID MUST be exactly request.auth.uid.
    // - Forgery of userId, uid, or email is strictly blocked.
    // - Modification of financial, role, or administrative fields is completely
    //   blocked for both users and admin profile updates.
    match /registered_users/{userId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        userId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );

      // Initial user registration allowlist with strict ownership binding
      allow create: if isAuthenticated() &&
        userId == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) &&
        (!('email' in request.auth.token) || request.resource.data.email == request.auth.token.email) &&
        request.resource.data.keys().hasOnly([
          'uid', 'userId', 'name', 'displayName', 'email', 'phone', 'avatar',
          'photoURL', 'source', 'registeredAt', 'createdAt'
        ]);

      // Profile updates restricted strictly to safe fields (even for admins)
      // Disallows tampering with walletBalance, enrolledCourses, role, etc.
      allow update: if isAuthenticated() &&
        (isAdmin() || userId == request.auth.uid || resource.data.userId == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'displayName', 'phone', 'avatar', 'photoURL', 'updatedAt'
        ]) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid) &&
        (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId);

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 6. PLATFORM PAYMENTS: platform_payments
    // ─────────────────────────────────────────────────────────────────────────
    // Read: Paying user can view only their own payment records. Admin can read all.
    // Supports owner-scoped collection queries: where('userId', '==', auth.uid)
    // Write: Server only (Razorpay webhook / server verification).
    match /platform_payments/{paymentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 7. WALLET LEDGER: wallet_ledger
    // ─────────────────────────────────────────────────────────────────────────
    // Read: User can read only their own ledger transactions. Admin can read all.
    // Supports owner-scoped collection queries: where('userId', '==', auth.uid)
    // Write: Immutable audit ledger. Client write denied.
    match /wallet_ledger/{ledgerId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 8. ADMIN MANAGEMENT & AUDIT LOGS: admin_users, admin_audit_logs
    // ─────────────────────────────────────────────────────────────────────────
    match /admin_users/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
