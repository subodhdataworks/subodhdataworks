# Security and Cache Headers for Cloudflare Pages

# 1. HTML entry documents: Never cache; always revalidate on navigation
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# 2. Static versioned bundles with content-hashed filenames: Cache immutably for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 3. Dynamic and authenticated API routes: Never cache across requests or users
/api/*
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  Vary: Authorization, Cookie, Accept-Encoding
